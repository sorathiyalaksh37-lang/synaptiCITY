{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/utils/__tests__",
    "src/utils/cache.ts",
    "src/utils/debug.ts",
    "src/utils/decay.ts",
    "src/utils/forwardPass.ts",
    "src/utils/interference.ts",
    "src/utils/networkState.ts",
    "src/utils/neuralNetwork.ts",
    "src/utils/recall.ts",
    "src/utils/teach.ts",
    "src/utils/hebbian.ts",
    "src/hooks/useNeuralNetwork.ts",
    "src/hooks/useStateHandlers.ts"
  ]
}
